<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 (API 28) blocks cleartext HTTP by default. This app talks to a PC
  on the local network over plain http/ws, so cleartext has to be permitted -
  but only where it is actually needed.

  Scoping matters: a blanket android:usesCleartextTraffic="true" would allow
  cleartext to *any* host, including the public internet. Restricting it to
  private address ranges keeps the relaxation to the LAN, where the traffic
  never leaves the local network and is protected by the pairing PIN instead.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- RFC 1918 private ranges, plus CGNAT (100.64/10) and link-local
         (169.254/16, which Windows hands out when DHCP fails). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- emulator host alias -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.2.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">10.1.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">169.254.0.0</domain>

        <!-- .local covers hostnames resolved by mDNS, which is how a
             discovered device may be addressed. -->
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>