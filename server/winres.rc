// Windows resource script for the Smart Remote server executable.
//
// Regenerate the compiled resource after changing the icon or the metadata:
//
//	windres -i winres.rc -O coff -o rsrc.syso
//
// windres must run from THIS directory: the paths below are relative, because
// the .syso is consumed by the Go linker with the module root as its working
// directory.
//
// The manifest is referenced as a resource below rather than passed as a flag,
// because GNU windres has no --manifest option (unlike MSVC's rc.exe).
//
// The icon is the multi-resolution .ico produced by tools/mkicon from the
// source logo. Keeping it generated rather than hand-drawn means the tray, the
// taskbar and the phone all show the same mark.
1 ICON "internal/remote/assets/smartremote.ico"

// RT_MANIFEST is resource type 24: the application's side-by-side manifest.
1 24 "winres.manifest"

// VERSIONINFO. The values are duplicated from AppVersion/Developer in
// internal/remote/brand.go because windres cannot read Go constants; keeping
// them here is what makes "About this app" on the phone and the executable's
// own file properties agree.
//
// BUILD_DEBUG is passed on the command line rather than switched with #ifdef:
// windres does not run the C preprocessor unless --preprocessor is given, so an
// #ifdef/#else block is a syntax error rather than a conditional.
1 VERSIONINFO
FILEVERSION     1,0,4,0
PRODUCTVERSION  1,0,4,0
// FILEFLAGSMASK is spelled numerically rather than as VS_FFI_FILEFLAGSMASK.
// GNU windres does not preload the Windows VERSIONINFO constants the way
// MSVC's rc.exe does, so the symbolic name is reported as a syntax error
// unless the C preprocessor is enabled with --preprocessor. The value is the
// stable, documented definition (0x3f).
FILEFLAGSMASK   0x3f
FILEFLAGS       0x0
// The remaining VERSIONINFO constants are likewise written numerically.
// GNU windres does not preload the Windows resource constants that MSVC's rc.exe
// defines, so every symbolic name here is a syntax error unless the C
// preprocessor is enabled with --preprocessor. The values are the documented,
// stable definitions and are listed in full so this file is readable on its own.
//
//	FILEOS        VOS_NT_WINDOWS32 = 0x00040004
//	FILETYPE      VFT_APP          = 0x00000001
//	FILESUBTYPE   VFT2_UNKNOWN     = 0x00000000
FILEOS          0x00040004
FILETYPE        0x00000001
FILESUBTYPE     0x00000000
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "elmamo"
            VALUE "FileDescription",  "Smart Remote Control"
            VALUE "FileVersion",      "1.0.4.0"
            VALUE "InternalName",     "smart-remote-server"
            VALUE "LegalCopyright",   "Copyright (c) 2026 elmamo"
            VALUE "OriginalFilename", "smart-remote-server.exe"
            VALUE "ProductName",      "Smart Remote Control"
            VALUE "ProductVersion",   "1.0.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END